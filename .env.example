# Copy this file to `.env` and fill in the values. Everything is optional —
# without them the app runs fully offline on the device.

# --- Supabase (accounts, cloud sync, shared community, photo storage) ---
# Supabase dashboard → Project Settings → API (or "Connect" button):
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY

# --- Free AI (recommended) ---
# Plant identification from photos — Pl@ntNet, free 500/day for non-commercial use.
# Sign up at https://my.plantnet.org → your account → API key.
EXPO_PUBLIC_PLANTNET_API_KEY=
# Diagnosis, chat assistant and care sheets — Google Gemini free tier.
# Get a key at https://aistudio.google.com/apikey (no credit card needed).
EXPO_PUBLIC_GEMINI_API_KEY=
# Optional: a different Gemini model name (see the model list in Google AI Studio).
EXPO_PUBLIC_GEMINI_MODEL=gemini-2.5-flash

# --- Paid AI alternative: Claude ---
# Set to true after deploying the `ai` Edge Function (see README) to get real AI
# for signed-in users. Your Anthropic key then lives only on the server.
EXPO_PUBLIC_SUPABASE_AI=false

# --- Without Supabase: call Claude directly (development only — the key can be extracted from the app) ---
EXPO_PUBLIC_ANTHROPIC_API_KEY=
EXPO_PUBLIC_ANTHROPIC_MODEL=claude-sonnet-5-5
