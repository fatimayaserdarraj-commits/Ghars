# Copy to .env and fill in what you need. All values are optional —
# without them the app runs fully offline with its built-in knowledge base.

# --- AI (plant identification, diagnosis, chat assistant) ---
# Option A (development only): call Claude directly from the app.
# A key bundled into a mobile app can be extracted — do not ship this to users.
EXPO_PUBLIC_ANTHROPIC_API_KEY=
# Option B (production): your own backend that forwards requests to the Anthropic Messages API.
EXPO_PUBLIC_AI_PROXY_URL=
# Optional model override.
EXPO_PUBLIC_ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Multi-device sync ---
# REST endpoint storing one JSON document per user: GET/PUT {url}/users/{id}
EXPO_PUBLIC_SYNC_URL=
