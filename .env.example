# Copy this file to `.env` and fill in the values. Everything is optional —
# without them the app runs fully offline on the device.

# --- Supabase (accounts, cloud sync, shared community, photo storage) ---
# Supabase dashboard → Project Settings → API (or "Connect" button):
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY

# Set to true after deploying the `ai` Edge Function (see README) to get real AI
# for signed-in users. Your Anthropic key then lives only on the server.
EXPO_PUBLIC_SUPABASE_AI=false

# --- Without Supabase: call Claude directly (development only — the key can be extracted from the app) ---
EXPO_PUBLIC_ANTHROPIC_API_KEY=
EXPO_PUBLIC_ANTHROPIC_MODEL=claude-sonnet-5-5
