{
  "expo": {
    "name": "Ghars",
    "slug": "ghars",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ghars",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/images/icon.png",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Ghars uses the camera to identify plants and diagnose plant health.",
        "NSPhotoLibraryUsageDescription": "Ghars uses your photos to identify plants and record growth.",
        "NSLocationWhenInUseUsageDescription": "Ghars uses your location to show nearby nurseries and garden shops."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1F251E",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "CAMERA",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1F251E",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 240
        }
      ],
      "expo-secure-store",
      "expo-localization",
      [
        "expo-image-picker",
        {
          "photosPermission": "Ghars uses your photos to identify plants and record growth.",
          "cameraPermission": "Ghars uses the camera to identify plants and diagnose plant health."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Ghars uses your location to show nearby nurseries and garden shops."
        }
      ],
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
